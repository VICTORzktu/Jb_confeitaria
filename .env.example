# ============================================================
# FitAI — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env real.
# ============================================================

# Porta do servidor
PORT=3000
# Banco: defina DATABASE_URL para usar PostgreSQL (sem ela, usa SQLite em data/fitai.db)
# Ex.: postgresql://postgres.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

NODE_ENV=development

# Segredo para assinar JWT (obrigatório em produção).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Caminho do banco SQLite (padrão: ./data/fitai.db)
# DATA_DIR=./data
# DB_PATH=./data/fitai.db

# Administrador criado no primeiro boot (troque em produção!)
ADMIN_EMAIL=admin@fitai.com
ADMIN_PASSWORD=troque-esta-senha

# Conta de demonstração criada no primeiro boot (opcional)
DEMO_EMAIL=demo@fitai.com
DEMO_PASSWORD=Demo@123456

# ------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL (a chave fica SOMENTE no servidor)
# Também pode ser configurada no Painel Admin > Integração com IA.
# ------------------------------------------------------------
# Provedores suportados:
# openai | anthropic | gemini | groq | openrouter | deepseek |
# mistral | xai | together | ollama | custom
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Gateway/proxy compatível com OpenAI (opcional — tem prioridade)
# AI_PROXY_URL=
# AI_PROXY_TOKEN=

# ------------------------------------------------------------
# PAGAMENTOS
# ------------------------------------------------------------
# Chave Pix para receber assinaturas (BR Code EMV gerado no backend)
PIX_KEY=
# PIX_HOLDER=FITAI
# PIX_CITY=SAO PAULO

# Provedor de cartão (a estrutura está pronta para PSP/webhook):
# stripe | mercadopago | pagarme | asaas
# CARD_PROVIDER=
# CARD_SECRET_KEY=
# CARD_WEBHOOK_SECRET=

# SMTP para envio de e-mail de recuperação de senha (opcional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="FitAI <no-reply@fitai.app>"

# Fuso horário usado para agenda e "treino de hoje"
APP_TZ=America/Sao_Paulo

# Permite exibir o app dentro de iframes (previews de sandbox).
# Padrão: 1 (liberado). Em produção, defina 0 para bloquear framing de outros
# domínios e voltar ao X-Frame-Options: SAMEORIGIN (proteção anti-clickjacking).
EMBED_ALLOWED=1

# Exibe as contas demo na tela de login.
# Em produção o padrão é OCULTAR; defina 0 para ocultar sempre ou 1 para exibir.
SHOW_DEMO_ACCOUNTS=1
